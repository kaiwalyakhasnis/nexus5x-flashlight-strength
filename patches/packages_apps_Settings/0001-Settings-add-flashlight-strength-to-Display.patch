 res/xml/display_settings.xml                  |  5 ++
 src/com/android/settings/DisplaySettings.java |  2 +
 ...lashlightStrengthPreferenceController.java | 78 +++++++++++++++++++
 4 files changed, 89 insertions(+)
 create mode 100644 src/com/android/settings/display/FlashlightStrengthPreferenceController.java

