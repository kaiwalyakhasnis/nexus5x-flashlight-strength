+package com.android.settings.display;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.res.Resources;
+import android.os.UserHandle;
+import android.support.v7.preference.Preference;
+import android.text.TextUtils;
+
+import com.android.settings.core.PreferenceControllerMixin;
+import com.android.settingslib.core.AbstractPreferenceController;
+
+/**
+ * Opens the SystemUI flashlight strength dialog, the same one shown on long press
+ * of the flashlight Quick Settings tile.
+ */
+public class FlashlightStrengthPreferenceController extends AbstractPreferenceController
+        implements PreferenceControllerMixin {
+
+    private static final String KEY_FLASHLIGHT_STRENGTH = "flashlight_strength";
+
+    private static final String SYSTEMUI_PACKAGE = "com.android.systemui";
+    private static final String ACTION_SHOW_FLASHLIGHT_STRENGTH =
+            "com.android.systemui.action.SHOW_FLASHLIGHT_STRENGTH";
+
+    public FlashlightStrengthPreferenceController(Context context) {
+        super(context);
+    }
+
+    @Override
+    public String getPreferenceKey() {
+        return KEY_FLASHLIGHT_STRENGTH;
+    }
+
+    @Override
+    public boolean isAvailable() {
+        final PackageManager pm = mContext.getPackageManager();
+        if (!pm.hasSystemFeature(PackageManager.FEATURE_CAMERA_FLASH)) {
+            return false;
+        }
+        try {
+            final Resources res = pm.getResourcesForApplication(SYSTEMUI_PACKAGE);
+            final int id = res.getIdentifier("config_flashlightStrengthProperty", "string",
+                    SYSTEMUI_PACKAGE);
+            return id != 0 && !TextUtils.isEmpty(res.getString(id));
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (!KEY_FLASHLIGHT_STRENGTH.equals(preference.getKey())) {
+            return false;
+        }
+        final Intent intent = new Intent(ACTION_SHOW_FLASHLIGHT_STRENGTH)
+                .setPackage(SYSTEMUI_PACKAGE);
+        mContext.sendBroadcastAsUser(intent, UserHandle.SYSTEM);
+        return true;
+    }
+}
