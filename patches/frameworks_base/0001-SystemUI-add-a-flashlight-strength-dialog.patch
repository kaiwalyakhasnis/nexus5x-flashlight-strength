+package com.android.systemui.flashlight;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/**
+ * Shows the flashlight strength dialog for Settings.
+ */
+public class FlashlightStrengthReceiver extends BroadcastReceiver {
+
+    public static final String ACTION_SHOW_FLASHLIGHT_STRENGTH =
+            "com.android.systemui.action.SHOW_FLASHLIGHT_STRENGTH";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
