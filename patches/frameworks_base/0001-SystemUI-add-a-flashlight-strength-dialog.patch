diff --git a/packages/SystemUI/src/com/android/systemui/flashlight/FlashlightBeamView.java b/packages/SystemUI/src/com/android/systemui/flashlight/FlashlightBeamView.java
new file mode 100644
index 00000000000..d580b5dde32
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/flashlight/FlashlightBeamView.java
@@ -0,0 +1,243 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.flashlight;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.os.Bundle;
+import android.util.AttributeSet;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.accessibility.AccessibilityNodeInfo;
+import android.widget.SeekBar;
+
+import com.android.systemui.R;
+
+import java.text.NumberFormat;
+
+/**
+ * Vertical slider drawn as a flashlight beam: a cone that widens upwards from a
+ * flashlight icon. The beam fills from the bottom up to the current level.
+ */
+public class FlashlightBeamView extends View {
+
+    public interface OnLevelChangeListener {
+        void onLevelChanged(int level);
+    }
+
+    private final Paint mTrackPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mLensPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path mBeamPath = new Path();
+    private final RectF mLensRect = new RectF();
+    private final Drawable mIcon;
+
+    private final int mFillColor;
+    private final int mFillTopColor;
+    private final int mOffFillColor;
+    private final float mLensHeight;
+    private final float mLensGap;
+    private final float mIconSize;
+    private final float mIconGap;
+
+    private float mBeamTop;
+    private float mBeamBottom;
+
+    private int mMax = 1;
+    private int mLevel = 1;
+    private boolean mTorchOn;
+    private OnLevelChangeListener mListener;
+
+    public FlashlightBeamView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        final float density = getResources().getDisplayMetrics().density;
+        mLensHeight = 6 * density;
+        mLensGap = 4 * density;
+        mIconSize = 40 * density;
+        mIconGap = 4 * density;
+
+        mFillColor = context.getColor(R.color.flashlight_strength_beam);
+        mFillTopColor = context.getColor(R.color.flashlight_strength_beam_top);
+        mOffFillColor = context.getColor(R.color.flashlight_strength_beam_off);
+        mTrackPaint.setColor(context.getColor(R.color.flashlight_strength_track));
+        mLensPaint.setColor(context.getColor(R.color.flashlight_strength_track));
+
+        mIcon = context.getDrawable(R.drawable.ic_signal_flashlight).mutate();
+        mIcon.setTint(mFillColor);
+
+        setFocusable(true);
+        setClickable(true);
+    }
+
+    public void setOnLevelChangeListener(OnLevelChangeListener listener) {
+        mListener = listener;
+    }
+
+    public void setMax(int max) {
+        mMax = Math.max(1, max);
+        mLevel = Math.min(mLevel, mMax);
+        updateContentDescription();
+        invalidate();
+    }
+
+    public void setLevel(int level) {
+        level = Math.max(1, Math.min(level, mMax));
+        if (level != mLevel) {
+            mLevel = level;
+            updateContentDescription();
+            invalidate();
+        }
+    }
+
+    public int getLevel() {
+        return mLevel;
+    }
+
+    public void setTorchOn(boolean on) {
+        if (on != mTorchOn) {
+            mTorchOn = on;
+            updateFillShader();
+            invalidate();
+        }
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        final float topWidth = w;
+        final float bottomWidth = w * 0.3f;
+        mBeamTop = mLensHeight + mLensGap;
+        mBeamBottom = h - mIconSize - mIconGap;
+
+        final float cx = w / 2f;
+        mBeamPath.reset();
+        mBeamPath.moveTo(cx - topWidth / 2f, mBeamTop);
+        mBeamPath.lineTo(cx + topWidth / 2f, mBeamTop);
+        mBeamPath.lineTo(cx + bottomWidth / 2f, mBeamBottom);
+        mBeamPath.lineTo(cx - bottomWidth / 2f, mBeamBottom);
+        mBeamPath.close();
+
+        mLensRect.set(0, 0, w, mLensHeight);
+
+        final int iconLeft = (int) (cx - mIconSize / 2f);
+        final int iconTop = (int) (h - mIconSize);
+        mIcon.setBounds(iconLeft, iconTop, iconLeft + (int) mIconSize, h);
+
+        updateFillShader();
+    }
+
+    private void updateFillShader() {
+        if (mTorchOn) {
+            mFillPaint.setShader(new LinearGradient(0, mBeamBottom, 0, mBeamTop,
+                    mFillColor, mFillTopColor, Shader.TileMode.CLAMP));
+        } else {
+            mFillPaint.setShader(null);
+            mFillPaint.setColor(mOffFillColor);
+        }
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        canvas.drawRoundRect(mLensRect, mLensHeight / 2f, mLensHeight / 2f, mLensPaint);
+        canvas.drawPath(mBeamPath, mTrackPaint);
+
+        final float fillTop = mBeamBottom - (mBeamBottom - mBeamTop) * mLevel / mMax;
+        canvas.save();
+        canvas.clipRect(0, fillTop, getWidth(), mBeamBottom);
+        canvas.drawPath(mBeamPath, mFillPaint);
+        canvas.restore();
+
+        mIcon.draw(canvas);
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        if (!isEnabled()) {
+            return false;
+        }
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                getParent().requestDisallowInterceptTouchEvent(true);
+                setPressed(true);
+                // fall through
+            case MotionEvent.ACTION_MOVE:
+                final float fraction = (mBeamBottom - event.getY()) / (mBeamBottom - mBeamTop);
+                updateLevelFromUser((int) Math.ceil(fraction * mMax));
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                setPressed(false);
+                getParent().requestDisallowInterceptTouchEvent(false);
+                return true;
+        }
+        return super.onTouchEvent(event);
+    }
+
+    private void updateLevelFromUser(int level) {
+        level = Math.max(1, Math.min(level, mMax));
+        if (level != mLevel || !mTorchOn) {
+            setLevel(level);
+            if (mListener != null) {
+                mListener.onLevelChanged(mLevel);
+            }
+        }
+    }
+
+    private void updateContentDescription() {
+        setContentDescription(getContext().getString(R.string.accessibility_flashlight_strength,
+                NumberFormat.getPercentInstance().format((float) mLevel / mMax)));
+    }
+
+    @Override
+    public CharSequence getAccessibilityClassName() {
+        return SeekBar.class.getName();
+    }
+
+    @Override
+    public void onInitializeAccessibilityNodeInfo(AccessibilityNodeInfo info) {
+        super.onInitializeAccessibilityNodeInfo(info);
+        info.setRangeInfo(AccessibilityNodeInfo.RangeInfo.obtain(
+                AccessibilityNodeInfo.RangeInfo.RANGE_TYPE_INT, 1, mMax, mLevel));
+        if (mLevel > 1) {
+            info.addAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_SCROLL_BACKWARD);
+        }
+        if (mLevel < mMax) {
+            info.addAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_SCROLL_FORWARD);
+        }
+    }
+
+    @Override
+    public boolean performAccessibilityAction(int action, Bundle arguments) {
+        if (!isEnabled()) {
+            return super.performAccessibilityAction(action, arguments);
+        }
+        if (action == AccessibilityNodeInfo.ACTION_SCROLL_FORWARD) {
+            updateLevelFromUser(mLevel + 1);
+            return true;
+        } else if (action == AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD) {
+            updateLevelFromUser(mLevel - 1);
+            return true;
+        }
+        return super.performAccessibilityAction(action, arguments);
+    }
+}
