+    public int getMaxStrengthLevel() {
+        return TextUtils.isEmpty(mStrengthProperty) ? 0 : mStrengthValues.length;
+    }
+
+    public int getStrengthLevel() {
+        final int max = getMaxStrengthLevel();
+        if (max == 0) return 0;
+        final int value = SystemProperties.getInt(mStrengthProperty, -1);
+        if (value < 0) {
+            return Math.max(1, Math.min(mDefaultStrengthLevel, max));
+        }
+        int level = 1;
+        for (int i = 0; i < max; i++) {
+            if (mStrengthValues[i] <= value) {
+                level = i + 1;
+            }
+        }
+        return level;
+    }
+
+    public void setStrengthLevel(int level) {
+        final int max = getMaxStrengthLevel();
+        if (max == 0) return;
+        final boolean post;
+        synchronized (this) {
+            // Only the latest level matters, drop levels passed while dragging
+            post = mPendingStrengthLevel == 0;
+            mPendingStrengthLevel = Math.max(1, Math.min(level, max));
+        }
+        if (post) {
+            ensureHandler();
+            mHandler.post(mApplyStrength);
+        }
+    }
+
+    private final Runnable mApplyStrength = this::applyPendingStrength;
+
+    private void applyPendingStrength() {
+        final int level;
+        final boolean reapply;
+        synchronized (this) {
+            level = mPendingStrengthLevel;
+            mPendingStrengthLevel = 0;
+            if (mCameraId == null) return;
+            reapply = mFlashlightEnabled;
+        }
+        try {
+            SystemProperties.set(mStrengthProperty, String.valueOf(mStrengthValues[level - 1]));
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Couldn't set torch strength", e);
+            return;
+        }
+        if (!reapply) {
+            setFlashlight(true);
+            return;
+        }
+        // Torch is already on, turning it on again makes the HAL re-read the strength
+        try {
+            mCameraManager.setTorchMode(mCameraId, true);
+        } catch (CameraAccessException e) {
+            Log.e(TAG, "Couldn't update torch strength", e);
+        }
+    }
