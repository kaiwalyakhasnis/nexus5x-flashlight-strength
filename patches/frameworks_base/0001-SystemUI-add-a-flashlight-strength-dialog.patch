+package com.android.systemui.flashlight;
+
+import android.content.Context;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.Button;
+
+import com.android.systemui.Dependency;
+import com.android.systemui.R;
+import com.android.systemui.statusbar.phone.SystemUIDialog;
+import com.android.systemui.statusbar.policy.FlashlightController;
+
+/**
+ * Flashlight strength dialog shown on long press of the flashlight tile.
+ */
+public class FlashlightStrengthDialog extends SystemUIDialog implements
+        FlashlightController.FlashlightListener {
+
+    private final Handler mUiHandler = new Handler(Looper.getMainLooper());
+    private final FlashlightController mController;
+
+    private FlashlightBeamView mBeam;
+    private Button mToggle;
+
+    public FlashlightStrengthDialog(Context context) {
+        super(context);
+        mController = Dependency.get(FlashlightController.class);
+        getWindow().setBackgroundDrawableResource(R.drawable.flashlight_strength_dialog_bg);
+    }
+
+    /** @return true if the flash unit supports changing its strength. */
+    public static boolean isSupported() {
+        return Dependency.get(FlashlightController.class).getMaxStrengthLevel() > 0;
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        final View view = LayoutInflater.from(getContext()).inflate(
+                R.layout.flashlight_strength_dialog, null);
+        // Replace the AlertDialog layout, it clips custom views and wraps the width
+        setContentView(view);
+        getWindow().setLayout(getContext().getResources().getDimensionPixelSize(
+                R.dimen.flashlight_strength_dialog_width), WindowManager.LayoutParams.WRAP_CONTENT);
+
+        mBeam = view.findViewById(R.id.flashlight_strength_beam);
+        mBeam.setMax(mController.getMaxStrengthLevel());
+        mBeam.setLevel(mController.getStrengthLevel());
+        mBeam.setOnLevelChangeListener(level -> {
+            mController.setStrengthLevel(level);
+            mBeam.setTorchOn(true);
+        });
+
+        mToggle = view.findViewById(R.id.flashlight_strength_toggle);
+        mToggle.setOnClickListener(v -> mController.setFlashlight(!mController.isEnabled()));
+        view.findViewById(R.id.flashlight_strength_done).setOnClickListener(v -> dismiss());
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        mController.addCallback(this);
+    }
+
+    @Override
+    protected void onStop() {
+        super.onStop();
+        mController.removeCallback(this);
+    }
+
+    private void updateState() {
+        final boolean on = mController.isEnabled();
+        mBeam.setTorchOn(on);
+        mToggle.setText(on ? R.string.flashlight_strength_turn_off
+                : R.string.flashlight_strength_turn_on);
+        mToggle.setEnabled(mController.isAvailable());
+        mBeam.setEnabled(mController.isAvailable());
+    }
+
+    @Override
+    public void onFlashlightChanged(boolean enabled) {
+        mUiHandler.post(this::updateState);
+    }
+
+    @Override
+    public void onFlashlightError() {
+        mUiHandler.post(this::updateState);
+    }
+
+    @Override
+    public void onFlashlightAvailabilityChanged(boolean available) {
+        mUiHandler.post(this::updateState);
+    }
+}
